# fixture: hiểu câu bằng bộ trích xuất giới hạn, không gọi mô hình.
CHAT_ADAPTER=fixture
# Chỉ khi chuyển CHAT_ADAPTER=openai; không tự chuyển về fixture khi lỗi.
OPENAI_API_KEY=
OPENAI_MODEL=

# Thử tại máy: CHAT_ADAPTER=ollama; không cần OPENAI_API_KEY.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Chỉ kết nối loopback; không dùng localhost của máy cá nhân trên Vercel.

# Gemini chỉ cấu hình trên máy chủ Vercel, không dùng NEXT_PUBLIC_* cho key.
# Giữ project Google AI Studio ở Free Tier, không bật billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Kho nguồn độc lập với model; chỉ fixture được kích hoạt trước khi nhận/xác minh tài liệu.
HUST_KNOWLEDGE_PACK=t6-fixture
